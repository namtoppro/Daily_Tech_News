# Gemini API key authentication
GEMINI_API_KEY=your_gemini_api_key_here

# Main text generation model
GEMINI_MODEL=gemini-3.1-pro-preview

# Audio script generation model (optional override)
AUDIO_SCRIPT_MODEL=gemini-3.1-pro-preview

# Gemini/native TTS model (optional, only set after validation)
GEMINI_TTS_MODEL=

# Output directory
ARCHIVE_DIR=archive
